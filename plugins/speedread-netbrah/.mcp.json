  "mcpServers": {
    "speedread": {
      "command": "sh",
      "args": [
        "${CLAUDE_PLUGIN_ROOT}/skills/speedread/scripts/speedread.sh",
        "mcp",
        "--unrestricted",
        "--no-cwd-root"
