  "instructions": {
    "where": "initialize result.instructions, not inside tools/list",
    "rooted_text": "speedread: fast, token-budgeted code reading. Prefer its tools over shell cat/sed/head/grep/find/ls and over one-file-at-a-time reads. Batch every file, range and symbol you need into ONE `read` call (`path`, `path:A-B`, `path#Symbol`, `#Symbol`, globs); oversized files come back as skeletons you expand by symbol instead of being cut off. `search` hits show their enclosing function/class; `trace` follows callers, callees, references and implementations; `map` orients you in a repo. After editing a file, read `path@etag` (etag from the `==>` header) to see only what changed.",
    "rootless_extra": " No project folder is configured here: give absolute paths (`/abs/dir/file.rs#Symbol`), or pass `base_dir` (an absolute directory) to scope a call to one project.",
    "rootless_o200k_tokens": 185,
    "rooted_o200k_tokens": 145
  },
